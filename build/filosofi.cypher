MERGE (n:Era {id: 'tidligt-1900-tal'}) SET n.da = 'Tidligt 1900-tal', n.en = 'Early 20th century', n.start = 1859, n.end = 1954, n.order = 8, n.note = 'Fænomenologi, analytisk filosofi, logisk positivisme, psykoanalyse og kritisk teori.';
MERGE (n:Era {id: 'midt-1900-tal'}) SET n.da = 'Midt-1900-tallet', n.en = 'Mid-20th century', n.start = 1889, n.end = 1979, n.order = 9, n.note = 'Eksistentialisme, hermeneutik, sprogfilosofi, videnskabsfilosofi og vestlig marxisme.';
