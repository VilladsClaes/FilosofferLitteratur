MERGE (n:Concept {id: 'arvesynden'}) SET n.da = 'Arvesynden', n.en = 'Original sin', n.kind = 'doktrin', n.note = 'Mennesket er født i en brusten tilstand og kan ikke frelse sig selv.', n.aar = 400, n.aarKilde = 'værk';
