MERGE (n:Era {id: 'tysk-idealisme'}) SET n.da = 'Tysk idealisme', n.en = 'German idealism', n.start = 1762, n.end = 1860, n.order = 6, n.note = 'Fichte, Schelling, Hegel, Schleiermacher og den tidlige Schopenhauer.';
