MERGE (n:Concept {id: 'panta-rhei'}) SET n.da = 'Panta rhei – "alt flyder"', n.en = 'Panta rhei', n.kind = 'doktrin', n.note = 'Intet blivende, kun forandring; man stiger ikke to gange ned i samme flod.', n.aar = -500, n.aarKilde = 'værk';
