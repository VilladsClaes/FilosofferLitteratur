MERGE (n:Concept {id: 'anti-fundamentisme'}) SET n.da = 'Anti-fundamentisme', n.en = 'Anti-foundationalism', n.kind = 'doktrin', n.note = 'Der findes ingen privilegeret grund under erkendelsen.', n.aar = 1979, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'liberal-ironiker'}) SET n.da = 'Den liberale ironiker', n.en = 'The liberal ironist', n.kind = 'begreb', n.note = 'At leve med sin egen private ironi og offentligt værne om andres frihed.', n.aar = 1979, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kompatibilisme'}) SET n.da = 'Kompatibilisme', n.en = 'Compatibilism', n.kind = 'doktrin', n.note = 'Frihed og determinisme udelukker ikke hinanden.', n.aar = 1991, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'multiple-drafts'}) SET n.da = 'Det multiple udkast', n.en = 'The multiple drafts model', n.kind = 'teori', n.note = 'Bevidsthed er ikke et sted i hjernen, men et resultat af parallelle processer.', n.aar = 1991, n.aarKilde = 'værk';
