MERGE (n:Concept {id: 'naturret'}) SET n.da = 'Naturret', n.en = 'Natural law', n.kind = 'teori', n.note = 'Der findes en ret, som er ældre og højere end den vedtagne lov. Grotius gjorde den til grundlag for retten mellem stater.', n.aar = -51, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'retorisk-filosofi'}) SET n.da = 'Retorisk filosofi', n.en = 'Rhetorical philosophy', n.kind = 'metode', n.note = 'Filosofien skal kunne tale til borgerne, ikke kun til skolen.', n.aar = -44, n.aarKilde = 'værk';
