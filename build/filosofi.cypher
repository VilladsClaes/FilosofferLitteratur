MERGE (n:Concept {id: 'ataraxia'}) SET n.da = 'Ataraxia', n.en = 'Ataraxia', n.kind = 'begreb', n.note = 'Den urokkelige sindsro, der følger af begærsbegrænsning.', n.aar = -300, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'dyd-er-det-eneste-gode'}) SET n.da = 'Dyden er det eneste gode', n.en = 'Virtue is the only good', n.kind = 'doktrin', n.note = 'Zenon: sundhed, rigdom og liv er "ligegyldige" i moralsk forstand.', n.aar = 180, n.aarKilde = 'værk';
