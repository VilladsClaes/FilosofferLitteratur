MERGE (n:Concept {id: 'dydsetik'}) SET n.da = 'Dydsetik', n.en = 'Virtue ethics', n.kind = 'isme', n.note = 'Spørgsmålet er ikke "hvad må jeg?", men "hvordan bliver jeg en god person?".', n.aar = -340, n.aarKilde = 'værk';
