// ── Unikhedsbegrænsninger ──
CREATE CONSTRAINT philosopher_id IF NOT EXISTS FOR (n:Philosopher) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT concept_id IF NOT EXISTS FOR (n:Concept) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT artifact_id IF NOT EXISTS FOR (n:Artifact) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT era_id IF NOT EXISTS FOR (n:Era) REQUIRE n.id IS UNIQUE;

// ── Noder ──
// 10 noder med label :Era
MERGE (n:Era {id: 'klassisk-kina'}) SET n.da = 'Klassisk kinesisk filosofi', n.en = 'Classical Chinese philosophy', n.start = -551, n.end = -233, n.order = 1, n.note = 'Den kinesiske "hundredårige skoleskrig" – konfucianisme, daoisme og deres samtidige.';
MERGE (n:Era {id: 'antikken'}) SET n.da = 'Antikken', n.en = 'Antiquity', n.start = -624, n.end = 270, n.order = 2, n.note = 'Fra Thales og den ioniske naturfilosofi til Plotin og nyplatonismen.';
MERGE (n:Era {id: 'middelalderen'}) SET n.da = 'Middelalderen og den islamiske verdens guldalder', n.en = 'Middle Ages & the Islamic Golden Age', n.start = 354, n.end = 1400, n.order = 3, n.note = 'Patristik, skolastik og den arabisk-jødiske aristotelisme (falsafa).';
