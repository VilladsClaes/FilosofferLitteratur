MERGE (n:Concept {id: 'dyreetik'}) SET n.da = 'Dyreetik', n.en = 'Animal ethics', n.kind = 'strømning', n.note = 'Kan de lide? Så tæller deres lidelse moralsk lige så tungt.', n.aar = 1975, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'effektiv-altruisme'}) SET n.da = 'Effektiv altruisme', n.en = 'Effective altruism', n.kind = 'doktrin', n.note = 'Gør mest muligt godt for pengene – også på verdensplan.', n.aar = 1975, n.aarKilde = 'værk';
