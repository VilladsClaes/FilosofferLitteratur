MERGE (n:Concept {id: 'kynisk-naturlighed'}) SET n.da = 'Kynisk naturlighed', n.en = 'Cynic naturalness', n.kind = 'doktrin', n.note = 'At leve efter naturen og håne konventionen.', n.aar = -330, n.aarKilde = 'værk';
