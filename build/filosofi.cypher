MERGE (n:Concept {id: 'lacansk-marxisme'}) SET n.da = 'Lacansk marxisme', n.en = 'Lacanian Marxism', n.kind = 'doktrin', n.note = 'Marxisme læst gennem psykoanalysen og begærets økonomi.', n.aar = 1989, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'performativitet'}) SET n.da = 'Performativitet', n.en = 'Performativity', n.kind = 'teori', n.note = 'Køn er noget, der gøres, igen og igen, gennem gentagelse af normer.', n.aar = 1990, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'koensteori'}) SET n.da = 'Kønsteori', n.en = 'Gender theory', n.kind = 'strømning', n.note = 'Skelnen mellem biologisk køn og socialt konstrueret køn.', n.aar = 1990, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'queer-teori'}) SET n.da = 'Queer-teori', n.en = 'Queer theory', n.kind = 'strømning', n.note = 'Kritik af enhver fast identitetskategori, også de frigørende.', n.aar = 1990, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'begivenhedsfilosofi'}) SET n.da = 'Begivenhedsfilosofi', n.en = 'Philosophy of the event', n.kind = 'doktrin', n.note = 'Sandhed opstår i begivenheder, der ikke kan forklares af situationens viden.', n.aar = 1988, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'sandhedsprocedurer'}) SET n.da = 'Sandhedsprocedurer', n.en = 'Truth procedures', n.kind = 'begreb', n.note = 'Politik, kunst, videnskab og kærlighed som måder at producere sandhed.', n.aar = 1988, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'autenticitet'}) SET n.da = 'Autenticitet', n.en = 'Authenticity', n.kind = 'begreb', n.note = 'At være sig selv er et historisk opstået ideal med et ansvar i sig.', n.aar = 1989, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'multikulturalisme'}) SET n.da = 'Multikulturalisme', n.en = 'Multiculturalism', n.kind = 'doktrin', n.note = 'Fælles politisk ramme uden at kræve kulturel ensretning.', n.aar = 1989, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kapabilitetstilgangen'}) SET n.da = 'Kapabilitetstilgangen', n.en = 'The capability approach', n.kind = 'teori', n.note = 'Det afgørende er, hvad mennesker reelt er i stand til at være og gøre.', n.aar = 1986, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kosmopolitisme'}) SET n.da = 'Kosmopolitisme', n.en = 'Cosmopolitanism', n.kind = 'doktrin', n.note = 'Alle mennesker er borgere i samme verden – grænsen er ikke den yderste horisont.', n.aar = 1986, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'profetisk-pragmatisme'}) SET n.da = 'Profetisk pragmatisme', n.en = 'Prophetic pragmatism', n.kind = 'doktrin', n.note = 'Tænkning, der blander sig: filosofien må være urolig og optaget af lidelse.', n.aar = 1982, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'racekritik'}) SET n.da = 'Racekritik', n.en = 'Race critique', n.kind = 'strømning', n.note = 'Race som social konstruktion med håndgribelige konsekvenser.', n.aar = 1982, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kulturkritik'}) SET n.da = 'Kulturkritik', n.en = 'Cultural criticism', n.kind = 'strømning', n.note = 'Nutidens åndsliv måles og findes let.', n.aar = 1987, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kulturel-relativisme'}) SET n.da = 'Kulturel relativisme', n.en = 'Cultural relativism', n.kind = 'problem', n.note = 'Er værdier blot konventioner, eller findes der fælles målestokke?', n.aar = 1987, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'ren-medmenneskelighed'}) SET n.da = 'Ren – medmenneskelighed', n.en = 'Ren', n.kind = 'begreb', n.note = 'At elske andre som sig selv og altid springe fra sig selv til den anden.', n.aar = -480, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'li-ritualer'}) SET n.da = 'Li – ritualer og skikke', n.en = 'Li', n.kind = 'begreb', n.note = 'Det formrigtige i det daglige liv holder samfundet sammen.', n.aar = -480, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'den-edle-mand'}) SET n.da = 'Junzi – den ædle mand', n.en = 'Junzi', n.kind = 'begreb', n.note = 'Det dannet-moderne menneske ideal, som dannelsesromanen siden spejler.', n.aar = -480, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'meritokrati'}) SET n.da = 'Meritokrati', n.en = 'Meritocracy', n.kind = 'doktrin', n.note = 'Den bedst egnede skal have magten – målt på dannelse, ikke byrd.', n.aar = -480, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'wu-wei'}) SET n.da = 'Wu wei – at handle ved ikke at handle', n.en = 'Wu wei', n.kind = 'princip', n.note = 'Den virkningsfulde handling, der ikke tvinger.', n.aar = -400, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'dao'}) SET n.da = 'Dao – vejen', n.en = 'Dao', n.kind = 'begreb', n.note = 'Den uudsigelige orden, som alt følger og ingen kan navngive.', n.aar = -400, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'naturlig-harmoni'}) SET n.da = 'Naturlig harmoni', n.en = 'Natural harmony', n.kind = 'doktrin', n.note = 'Menneskets velbefindende er afhængigt af samspillet med naturen.', n.aar = -400, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'evig-fred'}) SET n.da = 'Den evige fred (statsforbundet)', n.en = 'Perpetual peace', n.kind = 'doktrin', n.note = 'Kant: freden sikres ikke ved traktater alene, men ved et forbund af republikker, der giver afkald på krig. Idéen er en dokumenteret forudsætning for Folkeforbundet og FN-pagten – ikke en byggetegning, de blev rejst efter.', n.aar = 1795, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'havets-frihed'}) SET n.da = 'Mare liberum – havets frihed', n.en = 'Freedom of the seas', n.kind = 'doktrin', n.note = 'Havet er fælles ejendom for alle folk. Grotius\' stridsskrift mod de opdelte verdenshave blev indgangen til en ret mellem stater, der bygger på fornuft og sædvane.', n.aar = 1609, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'keynesianisme'}) SET n.da = 'Keynesianismen', n.en = 'Keynesian economics', n.kind = 'teori', n.note = 'Staten kan dæmpe ledighed og kriser ved at styre den samlede efterspørgsel. Keynes var en af hovedmændene bag Bretton Woods-institutionerne 1944.', n.aar = 1936, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'artsformynderi'}) SET n.da = 'Artsformynderi (speciesisme)', n.en = 'Speciesism', n.kind = 'doktrin', n.note = 'At tildele dyr mindre moralsk vægt, alene fordi de ikke er mennesker. Singer vendte kriteriet til følelsesevnen – og Bentham havde formuleret spørgsmålet 150 år før: "Kan de lide?"', n.aar = 1975, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'pansofisme'}) SET n.da = 'Pansofisme', n.en = 'Pansophism', n.kind = 'doktrin', n.note = 'Al viden for alle, ordnet trinvist. Comenius skitserede fire skoletrin og en systematisk sanselig metode; at kalde ham den moderne klasseundervisnings opfinder er en overdrivelse. Kilden beskriver en dokumenteret pædagogisk indflydelse.', n.aar = 1657, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'didaktik'}) SET n.da = 'Didaktik (undervisningens kunst)', n.en = 'Didactics', n.kind = 'metode', n.note = 'Undervisningen som et systematisk fag: orden, sanselighed og trin. Orbis Sensualium Pictus (1658) er den illustrerede lærebogs forløber.', n.aar = 1657, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'elementarmetoden'}) SET n.da = 'Pestalozzis elementarmetode', n.en = 'Pestalozzi\'s method', n.kind = 'metode', n.note = 'Hoved, hjerte og hånd skal dannes sammen, og undervisningen begynde i det konkrete. Yverdon blev et forbillede for læreruddannelsen – Pestalozzi grundlagde ikke folkeskolen alene.', n.aar = 1781, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'videnskabelig-paedagogik'}) SET n.da = 'Videnskabelig pædagogik', n.en = 'Scientific pedagogy', n.kind = 'teori', n.note = 'Pædagogik som videnskab: apperception, opdragende undervisning og undervisningens trin. Den standardiserede femtrins-model blev udformet af herbartianerne senere i århundredet, ikke af Herbart selv.', n.aar = 1806, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'leg-som-dannelse'}) SET n.da = 'Leg som dannelse', n.en = 'Play as formation', n.kind = 'doktrin', n.note = 'Fröbel gjorde legen til barnets eget arbejde: haven, gaverne og den frie leg (institution 1837, navnet Kindergarten 1840). Hedevig Bagger førte den til Danmark. Byggelegepladsen i Emdrup (1943) er udtryk for samme grundtanke, men opstod i en dansk landskabsarkitekttradition – ikke som udløber af Fröbel.', n.aar = 1826, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'skole-for-livet'}) SET n.da = 'Skolen for livet', n.en = 'School for life', n.kind = 'doktrin', n.note = 'Folkeoplysning frem for eksamen: en skole for livet, ikke for embedseksamen. Rødding (1844) blev rejst på Grundtvigs idé, men af Christian Flor. Folkehøjskoleloven (2019) skriver livsoplysning, folkelig oplysning og demokratisk dannelse som skolernes formål.', n.aar = 1808, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'det-levende-ord'}) SET n.da = 'Det levende ord', n.en = 'The living word', n.kind = 'metode', n.note = 'Den talte formidling frem for den døde bog. Christen Kold førte den ud i praksis: han underviste mundtligt og skrev næsten intet. Ryslinge 1851 blev forbillede for friskolerne.', n.aar = 1808, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'forberedte-omgivelser'}) SET n.da = 'De forberedte omgivelser', n.en = 'The prepared environment', n.kind = 'metode', n.note = 'Barnet vælger selv i et omhyggeligt tilrettelagt miljø, og materialerne er lavet til at vise fejlen. Casa dei Bambini (1907) blev udgangspunktet for Montessori-skoler verden over.', n.aar = 1909, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'myndighed'}) SET n.da = 'Myndighed – ud af selvforskyldt umyndighed', n.en = 'Intellectual maturity', n.kind = 'begreb', n.note = 'Kant: oplysning er at turde bruge sin egen forstand i stedet for at lade andre tænke for sig. Han mente åndelig myndighed, ikke juridisk – kilderne giver ingen linje fra essayet til den juridiske myndighedsalder.', n.aar = 1784, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kognitiv-udviklingstrappe'}) SET n.da = 'Piagets stadier', n.en = 'Piaget\'s stages of cognitive development', n.kind = 'teori', n.note = 'Barnet konstruerer selv sin forståelse gennem faser. Indflydelsen på pædagogikken er bred og dokumenteret, men skolerne indførte ikke nogen fast Piaget-tidsplan, og aldersgrænserne er omstridte.', n.aar = 1923, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'zonen-for-naermeste-udvikling'}) SET n.da = 'Zonen for nærmeste udvikling', n.en = 'Zone of proximal development', n.kind = 'teori', n.note = 'Det, barnet kan med hjælp, ligger forud for det, det kan alene. Ordet stilladsering er ikke Vygotskys: metaforen kom med Wood, Bruner og Ross i 1976 og blev først senere knyttet til zonen.', n.aar = 1934, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'legens-betydning'}) SET n.da = 'Legens betydning for udviklingen', n.en = 'The role of play in development', n.kind = 'teori', n.note = 'Vygotsky så legen som den vigtigste udviklingszone: i legen overskrider barnet sit aktuelle niveau. Den danske dagtilbudslovgivning gør legen grundlæggende i læringsmiljøet – et fagligt bånd over et århundrede, ikke en dokumenteret enkeltårsag.', n.aar = 1934, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'stilladsering'}) SET n.da = 'Stilladsering (scaffolding)', n.en = 'Scaffolding', n.kind = 'metode', n.note = 'Den voksne bygger støtte om opgaven og fjerner den, efterhånden som barnet kan selv. Ordet blev indført i en undersøgelse af børns problemløsning med en tutor i 1976.', n.aar = 1976, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'spiral-laereplan'}) SET n.da = 'Den spiralformede læreplan', n.en = 'Spiral curriculum', n.kind = 'teori', n.note = 'Store ideer skal tages igen på stadig højere niveau. Bruners bog fra Woods Hole-konferencen (1959/1960) blev afsæt for læreplansreformerne i naturfagene.', n.aar = 1960, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'blooms-taksonomi'}) SET n.da = 'Blooms taksonomi', n.en = 'Bloom\'s taxonomy', n.kind = 'metode', n.note = 'Undervisningsmål ordnet efter erkendelsesniveau, fra viden til vurdering. Rammen fra 1956 gjorde målene målbare; den reviderede udgave er fra 2001 og må ikke forveksles med den oprindelige.', n.aar = 1956, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'tavs-viden'}) SET n.da = 'Tavs viden (tacit knowledge)', n.en = 'Tacit knowledge', n.kind = 'begreb', n.note = 'Vi kan vide mere, end vi kan fortælle: viden sidder i hænder, vaner og dømmekraft. Polanyis skelnen blev grundlag for vidensledelse (Nonaka 1991). Mesterlære er en ældre praksis, som teorien forklarer – ikke en, den skabte.', n.aar = 1966, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'gettier-problemet'}) SET n.da = 'Gettier-problemet', n.en = 'The Gettier problem', n.kind = 'problem', n.note = 'Viden som retfærdiggjort sand tro tåler ikke mod-eksempler. Den tre sider lange artikel fra 1963 udløste et helt forskningsprogram – men grundlagde ikke epistemologien, som er meget ældre.', n.aar = 1963, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'social-konstruktion'}) SET n.da = 'Virkelighedens sociale konstruktion', n.en = 'The social construction of reality', n.kind = 'teori', n.note = 'Institutioner bliver til, når handlinger gentages og glemmer deres ophav. Bogen (1966) er en del af baggrunden for socialkonstruktivistisk pædagogik, men er ikke identisk med den – skolens konstruktivisme har også rødder hos Piaget og Vygotsky.', n.aar = 1966, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'situeret-laering'}) SET n.da = 'Situeret læring', n.en = 'Situated learning', n.kind = 'teori', n.note = 'Læring er deltagelse i et praksisfællesskab, hvor den nye bevæger sig fra periferien mod midten. Lave og Wenger analyserede mesterlære hos jordemødre og skræddere – de opfandt den ikke.', n.aar = 1991, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'kritisk-paedagogik'}) SET n.da = 'Kritisk pædagogik', n.en = 'Critical pedagogy', n.kind = 'strømning', n.note = 'Dialog og problemformulering frem for bankundervisning. Angicos-kampagnen (1963) kom før bogen (1968); Freire gav deltagende aktionsforskning et epistemologisk grundlag, men opfandt den ikke.', n.aar = 1968, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'afskoling'}) SET n.da = 'Afskoling', n.en = 'Deschooling', n.kind = 'doktrin', n.note = 'Illichs kritik: institutionel skolegang gør læring til en vare og skjuler, at man kan lære uden den. Kritikken er direkte; linjen videre til hjemmeundervisning og unschooling er et bredt slægtskab, ikke en dokumenteret ophavslinje.', n.aar = 1971, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'behovspyramiden'}) SET n.da = 'Behovspyramiden', n.en = 'Hierarchy of needs', n.kind = 'teori', n.note = 'Behov i rækkefølge, fra fysiologi til selvrealisering. Vejen ind i ledelse og HR er bredt dokumenteret – men den populære femtrins-pyramide er en forenkling, og teorien er blevet kritiseret empirisk og kulturelt.', n.aar = 1954, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'tofaktorteori'}) SET n.da = 'To-faktor-teorien', n.en = 'Two-factor theory', n.kind = 'teori', n.note = 'Utilfredshed fjernes med vilkår; motivation skabes med ansvar, præstation og vækst. Artiklen fra 1968 drev jobberigelse frem, og forsøg i britiske virksomheder byggede netop de elementer ind i jobbene.', n.aar = 1968, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'flow'}) SET n.da = 'Flow', n.en = 'Flow', n.kind = 'teori', n.note = 'Fuld optagethed, når udfordring og kunnen balancerer. Flow blev et designprincip i spil; undersøgelsen fra 2022 finder den bedste balance omkring spillerens eget niveau – og advarer om, at flow også kan øge trangen til at blive ved.', n.aar = 1990, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'tiltro-til-egen-formaaen'}) SET n.da = 'Tiltro til egen formåen (self-efficacy)', n.en = 'Self-efficacy', n.kind = 'begreb', n.note = 'Troen på, at man kan udføre handlingen, er en forudsætning for at gøre den. Begrebet blev grundlag for interventioner i sundhed, arbejde og skole; håndbogen bag er bag betalingsmur, så kun abstract og bibliografi kunne læses.', n.aar = 1977, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'vaeksttankesaet'}) SET n.da = 'Væksttankesættet (growth mindset)', n.en = 'Growth mindset', n.kind = 'teori', n.note = 'Fast eller udviklende opfattelse af sine egne evner. Interventionslinjen er dokumenteret – en stor undersøgelse løftede karakterer for svagere elever – men effekterne er uensartede og afhænger af elevernes vilkår og af klassens og kammeraternes kultur.', n.aar = 2006, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'psykosociale-stadier'}) SET n.da = 'Eriksons psykosociale stadier', n.en = 'Erikson\'s stages of psychosocial development', n.kind = 'teori', n.note = 'Udviklingen fortsætter hele livet: identitet, intimitet, generativitet og integritet. En dokumenteret vej ind i livsløbspsykologien – ikke en lov om, at alle går gennem stadierne på faste alderstrin.', n.aar = 1950, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'leg-som-kultur'}) SET n.da = 'Leg som kultur', n.en = 'Play as culture', n.kind = 'teori', n.note = 'Legen er ikke en pause fra kulturen, men en af dens kilder: ret, krig, kunst og religion har legens form. Huizinga er en dokumenteret reference i spilforskningen – det betyder ikke, at al spilforskning stammer fra ham.', n.aar = 1938, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'legenes-former'}) SET n.da = 'Legens fire former', n.en = 'The four categories of play', n.kind = 'teori', n.note = 'Agôn (konkurrence), alea (tilfælde), mimicry (efterligning) og ilinx (svimmelhed) – en taksonomi til at analysere leg og spil. Det er ikke spilteori i matematisk forstand.', n.aar = 1958, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'overgangsobjekt'}) SET n.da = 'Overgangsobjektet', n.en = 'Transitional object', n.kind = 'begreb', n.note = 'Tæppet eller bamsen, der holder barnet mellem indre og ydre virkelighed. Winnicotts leg og den tilstrækkeligt gode mor (1953) blev en klinisk ramme – det er ikke Bowlbys tilknytningsteori.', n.aar = 1971, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'tilknytningsteori'}) SET n.da = 'Tilknytningsteorien', n.en = 'Attachment theory', n.kind = 'teori', n.note = 'Barnets tidlige bånd har betydning hele livet. WHO-rapporten (1951) blev talerør for synet og prægede behandlingen af adskilte børn; senere forskning har kritiseret Bowlbys metoder og konklusioner.', n.aar = 1951, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'barndommen-som-konstruktion'}) SET n.da = 'Barndommen som historisk størrelse', n.en = 'Childhood as a historical construct', n.kind = 'teori', n.note = 'Barndommen har selv en historie og skiftende vilkår. Ariès (1960) gjorde den til et forskningsemne; hans påstand om middelalderens manglende barndomsbegreb er senere bestridt, blandt andet på grund af hans brug af billedkilder.', n.aar = 1960, n.aarKilde = 'værk';

