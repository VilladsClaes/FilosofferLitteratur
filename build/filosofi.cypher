MERGE (n:Concept {id: 'hylomorfisme'}) SET n.da = 'Hylomorfisme', n.en = 'Hylomorphism', n.kind = 'teori', n.note = 'Alt består af stof (hyle) og form (morphe) som uadskillelige aspekter.', n.aar = -340, n.aarKilde = 'værk';
