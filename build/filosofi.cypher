MERGE (n:Concept {id: 'rettighedsteori'}) SET n.da = 'Rettighedsteorien', n.en = 'Entitlement theory', n.kind = 'teori', n.note = 'Retfærdighed er historisk: er det, du har, erhvervet uden svig og tvang?', n.aar = 1974, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'minimalstaten'}) SET n.da = 'Minimalstaten', n.en = 'The minimal state', n.kind = 'begreb', n.note = 'En stat, der kun beskytter mod vold, tyveri og svig er den mest omfattende, der kan retfærdiggøres.', n.aar = 1974, n.aarKilde = 'værk';
