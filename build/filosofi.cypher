MERGE (n:Concept {id: 'stoisk-livskunst'}) SET n.da = 'Stoisk livskunst', n.en = 'Stoic art of living', n.kind = 'praksis', n.note = 'Filosofien som daglig øvelse i selviagttagelse og mådehold. Epiktets skelnen mellem tingen og dommen om tingen er den direkte forudsætning for den kognitive terapi.', n.aar = 65, n.aarKilde = 'værk';
MERGE (n:Concept {id: 'indre-frihed'}) SET n.da = 'Indre frihed', n.en = 'Inner freedom', n.kind = 'doktrin', n.note = 'Frit er kun det, der står i min magt: min dom og min vilje.', n.aar = 125, n.aarKilde = 'værk';
